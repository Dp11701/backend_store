# Thiên Nga API (NestJS + MongoDB)
# Copy: cp .env.example .env  →  điền AWS key thật vào .env (không commit)
#
# S3 console: https://us-east-1.console.aws.amazon.com/s3/buckets/phund-853516498568-us-east-1-an?region=us-east-1&prefix=store/

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8888
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,https://newton-unknighted-tiddly.ngrok-free.dev
JWT_SECRET=change-me-in-production

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://thiennga_dev:CHANGE_ME@cluster0.snprnop.mongodb.net/thiennga?retryWrites=true&w=majority&appName=Cluster0

# ── AWS S3 — bucket phund-853516498568-us-east-1-an, prefix store/ ───────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

S3_BUCKET_NAME=phund-853516498568-us-east-1-an
# URL công khai (CDN) — file vẫn upload lên S3, link API/CMS dùng CloudFront
S3_CDN_BASE_URL=https://d3vtqt24fe9cqo.cloudfront.net
S3_PUBLIC_BASE_URL=https://d3vtqt24fe9cqo.cloudfront.net
S3_UPLOAD_PREFIX=store

# URL ảnh sau upload: {S3_PUBLIC_BASE_URL}/{S3_UPLOAD_PREFIX}/products/ten-file.jpg
# Ví dụ: https://d3vtqt24fe9cqo.cloudfront.net/store/products/dam-aurelie.jpg

UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp
S3_PRESIGN_EXPIRES_IN=300
